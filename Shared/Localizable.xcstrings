          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto guardada. Agrega la otra foto para completar el par."
          }
        }
      }
    },
    "photo.importError": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有照片暂时无法读取。已保留可用照片，请从照片中补选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos could not be read. Any available photo was kept. Try choosing a photo stored on your device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有相片暫時無法讀取。已保留可用相片，請從相片中補選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真を読み込めませんでした。読み込めた写真は残してあります。端末に保存されている写真を選んでみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진을 읽지 못했습니다. 읽을 수 있는 사진은 보관했습니다. 기기에 저장된 사진을 골라 보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos konnten nicht gelesen werden. Verfügbare Fotos wurden behalten. Wähle ein Foto, das auf deinem Gerät gespeichert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer algunas fotos. Se conservaron las disponibles. Prueba con una foto guardada en tu dispositivo."
          }
        }
      }
    },
    "photo.importNone": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取所选照片。请重试，或选择已下载到本机的照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected photos could not be read. Try again or choose photos already downloaded to your device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法讀取所選相片。請再試一次，或選擇已下載到本機的相片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ写真を読み込めませんでした。もう一度試すか、端末にダウンロード済みの写真を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 사진을 읽지 못했습니다. 다시 시도하거나 기기에 다운로드된 사진을 고르세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählten Fotos konnten nicht gelesen werden. Versuche es erneut oder wähle bereits geladene Fotos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las fotos elegidas. Inténtalo de nuevo o elige fotos ya descargadas en tu dispositivo."
          }
        }
      }
    },
    "photo.denied": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
