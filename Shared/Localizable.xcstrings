    "photo.incomplete": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留选中的照片，可以补选另一张。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo kept. Add the other photo to finish the pair."
          }
        },
        "zh-Hant": {
