    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、草稿和成品由本机处理并存储。应用不收集你的数据，没有账号、广告或统计服务。系统可能从 iCloud 取回你选中的照片。你主动保存或分享时，系统会把所选成品交给对应位置或应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, drafts and exports are processed and stored on your device. The app collects no data and has no accounts, ads or analytics. The system may retrieve selected photos from iCloud. When you export or share, the system sends the chosen result to your selected destination."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相片、草稿和成品在本機處理與儲存。App 不收集你的資料，沒有帳號、廣告或統計服務。系統可能從 iCloud 取回你選取的相片。你主動儲存或分享時，系統會把所選成品交給指定位置或 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、下書き、書き出した画像は端末上で処理・保存されます。このアプリはデータを収集せず、アカウント、広告、分析ツールはありません。選んだ写真をシステムがiCloudから取得する場合があります。書き出しや共有の際は、選んだ結果をシステムが指定先に送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 임시 저장본, 내보낸 이미지는 기기에서 처리하고 저장합니다. 앱은 데이터를 수집하지 않으며 계정, 광고, 분석이 없습니다. 고른 사진을 시스템이 iCloud에서 가져올 수 있습니다. 내보내거나 공유하면 시스템이 고른 결과를 선택한 곳으로 보냅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, Entwürfe und Exporte werden auf deinem Gerät verarbeitet und gespeichert. Die App sammelt keine Daten und hat kein Konto, keine Werbung und keine Analyse. Das System lädt gewählte Fotos ggf. aus iCloud. Beim Exportieren oder Teilen sendet das System das gewählte Ergebnis an dein Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos, borradores y exportaciones se procesan y guardan en tu dispositivo. La app no recopila datos y no tiene cuentas, anuncios ni analíticas. El sistema puede traer de iCloud las fotos elegidas. Al exportar o compartir, el sistema envía el resultado elegido al destino que selecciones."
          }
        }
      }
    },
