    "photo.importError": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有照片暂时无法读取。已保留可用照片，请从照片中补选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos could not be read. Any available photo was kept. Try choosing a photo stored on your device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有相片暫時無法讀取。已保留可用相片，請從相片中補選。"
          }
        }
      }
    },
    "photo.importNone": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "暂时无法读取所选照片。请重试，或选择已下载到本机的照片。" } },
        "en": { "stringUnit": { "state": "translated", "value": "The selected photos could not be read. Try again or choose photos already downloaded to your device." } },
